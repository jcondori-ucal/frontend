# ==============================================================================
# KODO MOTORS · Portal Cliente (frontend-cliente)
# Plantilla de variables de entorno para el portal del cliente final
# Copia este archivo a ".env.local" para desarrollo local:
#   cp .env.example .env.local
# ==============================================================================

# Puerto en el que corre el servidor de Next.js (por defecto: 3001)
PORT=3001

# URL pública de la API REST backend de Kodo Motors.
# En desarrollo local:
#   - Déjalo vacío si usas el proxy interno de Next.js (next.config.js -> http://localhost:4000)
#   - O define explícitamente: http://localhost:4000
# En producción: https://api.kodomotors.pe
NEXT_PUBLIC_API_URL=http://localhost:4000

# Entorno de ejecución (development | production | test)
NODE_ENV=development

